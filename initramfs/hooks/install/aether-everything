# aether 救援镜像 — 全量无线套件 hook（"aether-everything"）
#
# 与其它 hook 的关系：
#   aether-network   —— 常见**有线** NIC（Intel/Realtek/Broadcom/virtio/vmxnet3/HV）
#   aether-keyboard  —— PS/2 + USB HID 键盘
#   aether-usb       —— USB 主控（host controller）
#   aether-everything—— **常见无线套件**（本 hook）：Intel / Realtek / Atheros / MediaTek / Broadcom WiFi，
#                      PCI 为主，不含 USB WiFi（本内核 USB WiFi 驱动繁多且Rescue 场景少用）。
#                      这不是"本机侦测"版（那是 aether-hostdrv），而是全量最大兼容版。
#
# 说明：
#   1) 全部用 'add_module <name>?'——模块不存在/是内建 → 静默跳过，不失败。
#   2) 依赖模块自动带入（mac80211/cfg80211/rfkill/libarc4/aead/ptp/m76-connac-lib 等）。
#   3) 无线网卡的 firmware 由 mkinitcpio add_module 自动按 modinfo firmware: 收集（单个驱动家族可达数 MiB）。
#   4) 全量镜像体积 ≈ 30–50 MiB；只给运行已知 WiFi 硬件或极端场景用。正常救援用默认 hook 即可。
#   5) 本程序**不支持在 rescue 里配置 WiFi**（netup/ifconfig 只做有线安全选路）：
#      带无线硬件但不配置它也能启动（wireless 接口不参与自动选路）。WiFi 支持=驱动仅随时可用。
#   6) 如果只需要本机某一类的固件黑名单，无法精细化——mkinitcpio add_module 的 firmware 自动收集是
#      整个 family 级别；想缩小体积请用 aether-hostdrv（无无线）或 aether-network（有线 only）。

build() {
    # Intel iwlwifi（含 WiFi 7 mlx→mld 驱动）
    add_module 'iwlwifi?'
    add_module 'iwlmvm?'
    add_module 'iwldvm?'
    add_module 'iwlmld?'

    # Realtek rtw88（WiFi 5）
    add_module 'rtw88_pci?'
    add_module 'rtw88_8723de?'
    add_module 'rtw88_8821ce?'
    add_module 'rtw88_8822be?'
    add_module 'rtw88_8851be?'
    add_module 'rtw88_8852be?'
    add_module 'rtw88_8852ce?'

    # Realtek rtw89（WiFi 6E/7）
    add_module 'rtw89_pci?'
    add_module 'rtw89_8851be?'
    add_module 'rtw89_8852be?'
    add_module 'rtw89_8852ce?'
    add_module 'rtw89_8922ae?'

    # Atheros ath9k（WiFi 4）/ ath10k（WiFi 5）/ ath11k（WiFi 6）/ ath12k（WiFi 7）
    add_module 'ath9k?'
    add_module 'ath10k_pci?'
    add_module 'ath11k_pci?'
    add_module 'ath12k_pci?'
    add_module 'ath12k_wifi7?'

    # MediaTek MT76 WiFi 6E/7（AX210 竞品）
    add_module 'mt7921e?'
    add_module 'mt7925e?'

    # Broadcom brcmfmac（部分笔记本/Mac 常见 Broadcom WiFi）
    add_module 'brcmfmac?'

    return 0
}

help() {
    cat <<HELPEOF
aether rescue image — "everything" wireless hook

Adds the common laptop WiFi driver stacks (Intel iwlwifi incl. WiFi 7 mld,
Realtek rtw88/rtw89, Qualcomm/Atheros ath9k/ath10k/ath11k/ath12k, MediaTek
MT76, Broadcom brcmfmac) plus their declared firmware, so a rescue image can
acquire connectivity from almost any modern wireless chipset. This is wider
than typical rescue images (full image can reach ~30-50 MiB); use the default
hooks for a lean image. Note: this program does not support configuring WiFi
from the rescue shell — the driver is present but network auto-bring-up stays
wired-only.
HELPEOF
}

