#!/bin/bash
# aether rescue image — keyboard hook.
# Purpose: make the rescue shell immediately interactive with a PS/2 or USB
# keyboard on kernels that build these as modules. Many modern kernels build
# them in (Arch does), in which case this hook is a no-op fallback; the
# rescue shell always works with /dev/ttyS0 serial console regardless.
# Usage: HOOKS=(aether aether-keyboard)

build() {
    add_module 'i8042?'              # PS/2 controller I/O ports (PNP0C09/PNP0C0A)
    add_module 'serio_i8042?'
    add_module 'serio_libps2?'
    add_module 'atkbd?'              # PS/2 keyboard driver
    add_module 'serio_ps2mult?'
    add_module 'serio_raw?'
    add_module 'hid-generic?'        # USB HID generic fallback (when dedicated driver absent)
    add_module 'usbhid?'             # USB HID host protocol driver
    add_module 'xhci-hcd?'
    add_module 'xhci-pci?'
    add_module 'ehci-hcd?'
    add_module 'ehci-pci?'
}

help() {
    cat <<HELPEOF
aether rescue image — keyboard hook
Provides PS/2 and USB keyboard modules for rescue-mode interactivity
(tty0 / USB HID paths). Most modern kernels build these in; this hook
exists mainly as a portable fallback. The rescue shell also works over
/dev/ttyS0 serial console without this hook.
HELPEOF
}

